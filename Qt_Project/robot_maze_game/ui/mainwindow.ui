  <property name="windowTitle">
   <string>Robot Maze Escape</string>
  </property>
  <property name="styleSheet">
   <string notr="true">QMainWindow, QWidget#centralWidget {
    background-color: #0b1115;
    color: #e8f0f3;
    font-family: "Noto Sans CJK KR", "Noto Sans KR", sans-serif;
}
QLabel {
    color: #e8f0f3;
    background-color: transparent;
}
QFrame#headerFrame, QFrame#gameFrame, QFrame#sidePanel {
    background-color: #10181d;
    border: 1px solid #2a3a42;
    border-radius: 10px;
}
QLabel#logoLabel {
    background-color: #2de38b;
    color: #07130d;
    border-radius: 8px;
}
QLabel#appSubtitleLabel {
    color: #81949c;
}
QLabel#connectionLabel {
    color: #ffb84d;
}
QLabel#connectionLabel[state="connected"] {
    color: #63e9a5;
}
QLabel#connectionLabel[state="connecting"] {
    color: #59b8ff;
}
QLabel#connectionLabel[state="offline"] {
    color: #ffb84d;
}
QLabel#stageLabel {
    color: #dfe9ed;
}
QLabel#mapLegendLabel {
    color: #b7c7cd;
    padding-left: 8px;
}
QLabel#gameStatusLabel {
    color: #63e9a5;
    background-color: #10241b;
    border: 1px solid #315448;
    border-radius: 6px;
    padding: 5px 10px;
}
QLabel#gameStatusLabel[state="ready"] {
    color: #8dd6ff;
    background-color: #10222b;
    border-color: #315165;
}
QLabel#gameStatusLabel[state="active"], QLabel#gameStatusLabel[state="won"] {
    color: #63e9a5;
    background-color: #10241b;
    border-color: #315448;
}
QLabel#gameStatusLabel[state="paused"] {
    color: #ffd166;
    background-color: #2a2413;
    border-color: #66542a;
}
QLabel#gameStatusLabel[state="error"], QLabel#gameStatusLabel[state="lost"] {
    color: #ff7b84;
    background-color: #2a1519;
    border-color: #6b333a;
}
QGraphicsView#gameView {
    background-color: #0c1418;
    border: 1px solid #2a3c44;
    border-radius: 8px;
}
QFrame#statusFrame, QFrame#missionFrame, QFrame#controlFrame {
    background-color: #111b20;
    border: 1px solid #293b43;
    border-radius: 8px;
}
QLabel[role="caption"] {
    color: #80939b;
}
QLabel[role="value"] {
    color: #f0f6f8;
}
QFrame[role="divider"] {
    color: #2a3a42;
}
QPushButton {
    min-height: 34px;
    color: #dce7eb;
    background-color: #1a282e;
    border: 1px solid #344951;
    border-radius: 6px;
    padding: 5px 10px;
    font-weight: 600;
}
QPushButton:hover {
    background-color: #23343b;
    border-color: #4c6872;
}
QPushButton:pressed {
    background-color: #132027;
}
QPushButton:focus {
    border-color: #63e9a5;
}
QPushButton:disabled {
    color: #687980;
    background-color: #121c21;
    border-color: #25343a;
}
QPushButton#startButton {
    color: #07130d;
    background-color: #2de38b;
    border-color: #2de38b;
}
QPushButton#startButton:hover {
    background-color: #51efa0;
    border-color: #7af4b7;
}
QPushButton#startButton:pressed {
    background-color: #20bf70;
}
QPushButton#startButton:disabled {
    color: #60736a;
    background-color: #193328;
    border-color: #284b3b;
}
QComboBox {
    min-height: 28px;
    color: #e8f0f3;
    background-color: #1a282e;
    border: 1px solid #344951;
    border-radius: 5px;
    padding: 2px 8px;
}
QComboBox QAbstractItemView {
    color: #e8f0f3;
    background-color: #111b20;
    selection-background-color: #275943;
}
QMessageBox {
    background-color: #111b20;
}
QMessageBox QLabel {
    color: #e8f0f3;
}
QProgressBar#batteryProgressBar {
    background-color: #24343a;
    border: none;
    border-radius: 4px;
}
QProgressBar#batteryProgressBar::chunk {
    background-color: #2de38b;
    border-radius: 4px;
}
QProgressBar#batteryProgressBar[level="warning"]::chunk {
    background-color: #ffd166;
}
QProgressBar#batteryProgressBar[level="critical"]::chunk {
    background-color: #ff5b66;
}
QPlainTextEdit#eventLogEdit {
    color: #93a5ac;
    background-color: #0d1519;
    border: 1px solid #293b43;
    border-radius: 8px;
    padding: 8px;
    font-family: monospace;
    font-size: 9pt;
}</string>
